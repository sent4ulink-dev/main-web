{
  "name": "sent4u-thanksgiving",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A warm 3D Thanksgiving invitation for the whole family: everyone gets a seat at the long farmhouse table, dresses up their own character, RSVPs, shares what they are thankful for, pulls the wishbone, watches the parade and poses for the family photo.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && node ../../scripts/deploy-card.mjs thanksgiving",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "gsap": "3.15.0",
    "postprocessing": "6.39.5",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "ffmpeg-static": "^5.3.0",
    "meshoptimizer": "^0.25.0",
    "sharp": "^0.35.5",
    "vite": "^8.3.4",
    "wrangler": "^4.151.0"
  }
}
