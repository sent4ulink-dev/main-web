# The step editor shows this same page in a frame of its own (?embed=1), so the page may be framed by itself (and
# nobody else); its fonts come from Google Fonts and a song's picture from YouTube.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Frame-Options: SAMEORIGIN
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' blob: data: https://i.ytimg.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https:; media-src 'self' blob:; frame-src 'self' https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'
