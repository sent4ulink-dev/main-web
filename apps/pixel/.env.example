# Frontend build variables (Cloudflare Pages)
VITE_API_BASE_URL=https://your-render-service.onrender.com

# Backend variables (Render)
# Set by the sent4u order Worker; gates POST /shares/:id/ensure so only a real,
# paid order can mint a share. Leave unset in dev for an open (unsecured) /ensure.
SHARE_CREATE_SECRET=choose-a-strong-shared-secret
CORS_ALLOWED_ORIGINS=https://sent4u.link
# The sent4u order Worker's origin, used to self-heal a share that isn't in this
# app's own storage yet by confirming with the Worker that the id was really paid
# for and is really for Pixel. Leave unset to disable self-heal.
ORDERS_API_BASE=

# Optional private Cloudflare R2 storage. The API uses local JSON when omitted.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
