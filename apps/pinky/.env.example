# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Share system (frontend + this backend both live under sent4u.link) ---
# There is no public studio and no password any more — a real invitation only ever
# exists because the sent4u order Worker created it (POST /api/shares/:id/ensure)
# right after someone paid for a Pinky link. This app never mints a share id itself.

# VITE_API_BASE_URL: where the frontend sends share reads/writes. Leave unset for
# local dev (uses the Vite proxy to this server instead).
VITE_API_BASE_URL=""

# CORS_ORIGIN: set on this API's deployment to the exact origin it's served from
# (https://sent4u.link). Leave unset for local dev (allows all).
CORS_ORIGIN="https://sent4u.link"

# API_PORT: port the Express share API listens on locally, if 8787 is taken.
API_PORT="8787"

# GOOGLE_PLACES_API_KEY: server-side only (never sent to the browser) — powers the
# "Fetch from Maps" button in the Restaurant editor. Create one in Google Cloud Console
# (enable "Places API", create an API key) and set it here.
GOOGLE_PLACES_API_KEY="MY_GOOGLE_PLACES_API_KEY"

# SHARE_CREATE_SECRET: server-side only — gates POST /api/shares/:id/ensure, the
# endpoint the sent4u order Worker calls (server-to-server, never from a browser) the
# moment a paid order generates this id. Set the SAME value here and on the Worker.
# Sent as the "x-date-create-secret" header. Leave unset only for local dev — in
# production this must be set, or /ensure is wide open to anyone.
SHARE_CREATE_SECRET=""

# ORDERS_API_BASE: address of the sent4u order Worker, used only to self-heal a link
# that's opened before /ensure has finished (GET /links/:id — confirms the id was
# really paid for, and is really a Pinky link, before creating it here). Leave unset
# to disable self-heal; /ensure remains the normal way a share comes into existence.
ORDERS_API_BASE=""

# --- Share storage: Cloudflare R2 (optional — falls back to a local JSON file when
# any of these four are unset, which is what local dev uses by default) ---
# All four are server-side only, set on the Render (urilga-api) service. See
# DEPLOY.md "Storing shares in Cloudflare R2" for how to create the bucket + token.

# R2_ACCOUNT_ID: your Cloudflare account ID (Cloudflare dashboard → R2 → Overview,
# shown in the right-hand panel — NOT the R2 API token itself).
R2_ACCOUNT_ID="MY_CLOUDFLARE_ACCOUNT_ID"

# R2_BUCKET_NAME: the bucket you create for this (e.g. "urilga-shares").
R2_BUCKET_NAME="urilga-shares"

# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY: from an R2 API token (Cloudflare dashboard
# → R2 → Manage API Tokens → Create API Token) scoped to Object Read & Write on just
# this bucket. Shown once at creation — save it somewhere, Cloudflare won't show the
# secret again.
R2_ACCESS_KEY_ID="MY_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="MY_R2_SECRET_ACCESS_KEY"
